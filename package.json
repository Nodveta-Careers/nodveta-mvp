  "version": "1.0.0",
  "description": "NodeMeta - Scalable Web3 decentralized ecosystem MVP",
  "private": true,
  "homepage": "https://node-meta.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/Node-Meta-Careers/nodemeta-mvp"
  },
  "keywords": [
    "web3",
    "defi",
    "nft",
    "blockchain",
    "bsc",
    "cross-chain",
    "trading",
    "staking",
    "commerce"
  ],
  "dependencies": {
    "@ant-design/icons": "^4.7.0",
