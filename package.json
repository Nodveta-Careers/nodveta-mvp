    "@emotion/styled": "^11.6.0",
    "@mui/icons-material": "^5.2.0",
    "@mui/lab": "^5.0.0-alpha.57",
    "@mui/material": "^5.2.1",
    "@walletconnect/web3-provider": "^1.6.6",
    "@web3-react/core": "^6.1.9",
    "@web3-react/injected-connector": "^6.0.7",
    "@web3-react/walletconnect-connector": "^6.2.8",
    "antd": "^4.16.13",
    "awesome-phonenumber": "^6.8.0",
    "body-parser": "^1.20.2",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.6",
    "cookie-session": "^2.1.0",
    "dotenv": "^16.0.0",
    "ethers": "^5.5.2",
    "express": "^4.19.2",
    "hpp": "^0.2.3",
    "http-status": "^1.7.4",
    "jimp": "^0.22.12",
    "moment": "^2.29.1",
    "mongoose": "^8.3.4",
    "moralis": "^0.0.176",
    "next": "^16.3.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pino": "^9.3.2",
    "react": "^18.3.1",
    "react-blockies": "^1.4.1",
    "react-copy-to-clipboard": "^5.0.4",
    "react-countdown": "^2.3.2",
    "react-dom": "^18.3.1",
    "react-moralis": "^0.3.0",
    "react-player": "^2.10.0",
    "request-ip": "^3.3.0",
