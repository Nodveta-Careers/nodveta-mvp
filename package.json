  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^5.11.4",
    "@testing-library/react": "^11.1.0",
    "@testing-library/user-event": "^12.1.10",
    "autoprefixer": "^10.4.20",
    "concurrently": "^7.6.0",
    "pino-pretty": "^11.2.2",
    "postcss": "^8.4.41",
    "postcss-import": "^16.1.0",
    "request": "^2.88.2",
    "tailwind-merge": "^2.5.2",
    "tailwindcss": "^3.4.10",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-debug-screens": "^2.2.1"
  },
  "scripts": {
    "clean": "node scripts/clean.js",
    "dev": "concurrently \"PORT=4002 node server/index.js\" \"next dev -p 5000\" --kill-others --kill-others-on-fail",
    "dev:next": "next dev -p 5000",
    "dev:server": "node server/index.js",
    "build": "next build",
    "devchain": "node Truffle/scripts/devChain.js",
    "connect": "moralis-admin-cli connect-local-devchain",
    "watch:events": "moralis-admin-cli add-contract",
    "deploy:truffle": "node Truffle/scripts/deployContract.js",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "production:build": "NODE_ENV=production npm run build",
    "production:start": "NODE_ENV=production npm start",
    "docker:build": "docker build -t nodemeta-mvp:latest .",
    "docker:run": "docker run -p 3000:3000 -p 4000:4000 nodemeta-mvp:latest",
    "docker:compose": "docker-compose up -d",
    "docker:compose:dev": "docker-compose -f docker-compose.yml -f docker-compose.dev.yml up -d",
    "docker:compose:prod": "docker-compose -f docker-compose.yml up -d",
    "deploy": "./deploy.sh deploy",
    "deploy:rollback": "./deploy.sh rollback",
    "deploy:backup": "./deploy.sh backup",
    "deploy:health": "./deploy.sh health",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  }
}
