# NodeMeta Ecosystem MVP Environment Configuration

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/nodemeta-mvp

# Moralis Configuration (Legacy - for development)
NEXT_PUBLIC_MORALIS_APP_ID=your_moralis_app_id_here
NEXT_PUBLIC_MORALIS_SERVER_URL=your_moralis_server_url_here
NEXT_PUBLIC_MORALIS_USE_STUB=true

# API Configuration  
NEXT_PUBLIC_API_URL=http://localhost:4003/api
PORT=4003

# NodeMeta Specific Configuration
NEXT_PUBLIC_NTE_TOKEN_ADDRESS=0x4c1b07164080A652cB1B7B1c61951c082c9e5FF8
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed1.defibit.io/
NEXT_PUBLIC_BSC_CHAIN_ID=56

# Cross-chain Configuration
NEXT_PUBLIC_ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/your_infura_key
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-rpc.com/
NEXT_PUBLIC_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Trading & DeFi Integration
NEXT_PUBLIC_1INCH_API_KEY=your_1inch_api_key_here
NEXT_PUBLIC_DEX_AGGREGATOR_URL=https://api.1inch.io/v4.0/

# IPFS Configuration
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs/
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret

# Security & Authentication  
JWT_SECRET=your_jwt_secret_here_for_production
SESSION_SECRET=your_session_secret_here

# External APIs
COINGECKO_API_URL=https://api.coingecko.com/api/v3/
BSC_SCAN_API_KEY=your_bscscan_api_key
ETHERSCAN_API_KEY=your_etherscan_api_key

# Node Environment
NODE_ENV=development

# Server Configuration
SERVER_PORT=4003
FRONTEND_PORT=3001