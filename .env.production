# NodeMeta MVP - Production Environment Configuration
# Copy to .env.local for local production testing

# Application
NODE_ENV=production
PORT=4000
NEXT_PUBLIC_APP_ENV=production

# NodeMeta Configuration
NEXT_PUBLIC_SITE_NAME="NodeMeta Ecosystem"
NEXT_PUBLIC_SITE_URL="https://node-meta.com"
NEXT_PUBLIC_VERSION="1.0.0"

# Database Configuration
MONGODB_URI=mongodb://admin:nodemeta2024!@localhost:27017/nodemeta-mvp?authSource=admin
REDIS_URL=redis://localhost:6379

# Blockchain Configuration - BSC Mainnet
NEXT_PUBLIC_BSC_RPC_URL=https://bsc-dataseed1.binance.org/
NEXT_PUBLIC_ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
NEXT_PUBLIC_POLYGON_RPC_URL=https://polygon-rpc.com/
NEXT_PUBLIC_ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Smart Contracts - Production Addresses
NEXT_PUBLIC_NTE_TOKEN_ADDRESS=0x4c1b07164080A652cB1B7B1c61951c082c9e5FF8
NEXT_PUBLIC_STAKING_CONTRACT_ADDRESS=0x727ab05e93a7406eF02Dd9B6E068e4900E4a8b0B
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=0xe66326CE9B97Bd59CCE370692aeeF8fA9feadEF6
NEXT_PUBLIC_BRIDGE_CONTRACT_ADDRESS=0x1A2B3C4D5E6F7A8B9C0D1E2F3A4B5C6D7E8F9A0B
NEXT_PUBLIC_COMMERCE_CONTRACT_ADDRESS=0x2BF13D124b8C3D0a5E5916C2F8e5C0F0e4C4B8F9

# External API Keys (Production)
NEXT_PUBLIC_1INCH_API_KEY=your_1inch_production_api_key
COINGECKO_API_KEY=your_coingecko_api_key
DEXSCREENER_API_KEY=your_dexscreener_api_key

# Moralis Configuration (if using)
NEXT_PUBLIC_MORALIS_USE_STUB=false
NEXT_PUBLIC_MORALIS_APP_ID=your_moralis_production_app_id
NEXT_PUBLIC_MORALIS_SERVER_URL=your_moralis_production_server_url

# Security
JWT_SECRET=your_jwt_secret_key_minimum_256_bits
ENCRYPTION_KEY=your_encryption_key_32_characters
SESSION_SECRET=your_session_secret_key

# CORS Configuration
ALLOWED_ORIGINS=https://node-meta.com,https://www.node-meta.com,https://app.node-meta.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (Production SMTP)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
FROM_EMAIL=noreply@node-meta.com

# AWS Configuration (if using S3 for file storage)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=nodemeta-production-assets

# CDN Configuration
NEXT_PUBLIC_CDN_URL=https://cdn.node-meta.com

# Analytics
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token

# Monitoring
SENTRY_DSN=your_sentry_dsn_for_error_tracking
DATADOG_API_KEY=your_datadog_api_key

# Social Media & Marketing
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/NodeMetaOfficial
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/NodeMetaOfficial
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/NodeMeta
NEXT_PUBLIC_GITHUB_URL=https://github.com/NodeMeta

# Feature Flags
NEXT_PUBLIC_ENABLE_TRADING_BOT=true
NEXT_PUBLIC_ENABLE_CROSS_CHAIN_BRIDGE=true
NEXT_PUBLIC_ENABLE_SMART_COMMERCE=true
NEXT_PUBLIC_ENABLE_TOKENOMICS_DASHBOARD=true
NEXT_PUBLIC_ENABLE_STAKING=true
NEXT_PUBLIC_ENABLE_NFT_MARKETPLACE=true

# Performance
NEXT_PUBLIC_ENABLE_SERVICE_WORKER=true
NEXT_PUBLIC_CACHE_TTL=3600

# Logging
LOG_LEVEL=info
LOG_FILE_MAX_SIZE=10MB
LOG_FILE_MAX_FILES=5